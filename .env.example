# ============================================================
# LF Cowork — Environment Variables Template
# Copy to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# OpenRouter (server-side only — never expose to browser)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
# Optional: override the default model (default: anthropic/claude-sonnet-4-5)
# Any model slug from https://openrouter.ai/models works here, e.g.:
#   anthropic/claude-opus-4-7
#   openai/gpt-4o
#   google/gemini-2.5-pro
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5

# NextAuth
NEXTAUTH_SECRET=                  # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000

# Azure AD App Registration
AZURE_AD_CLIENT_ID=               # Application (client) ID
AZURE_AD_CLIENT_SECRET=           # Client secret value
AZURE_AD_TENANT_ID=               # Directory (tenant) ID

# Database — choose one
# Azure Cosmos DB
COSMOS_DB_ENDPOINT=https://your-account.documents.azure.com
COSMOS_DB_KEY=

# Optional: LF internal portal integration
LF_PORTAL_API_KEY=
LF_PORTAL_BASE_URL=https://your-visit-portal.com
